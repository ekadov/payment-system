<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <springProperty scope="context" name="appName" source="spring.application.name" defaultValue="transaction-service"/>

    <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <includeMdcKeyName>traceId</includeMdcKeyName>
            <includeMdcKeyName>spanId</includeMdcKeyName>
            <includeMdcKeyName>userId</includeMdcKeyName>
            <customFields>{"service.name":"${appName}"}</customFields>
            <fieldNames>
                <timestamp>timestamp</timestamp>
                <level>level</level>
                <logger>logger</logger>
                <thread>thread</thread>
                <message>message</message>
                <stackTrace>stackTrace</stackTrace>
            </fieldNames>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="JSON"/>
    </root>

    <!-- Отправка в Loki только в docker-compose (профиль loki): в тестах Loki недоступен. -->
    <springProfile name="loki">
        <springProperty scope="context" name="LOKI_URL" source="logging.loki.url"
                        defaultValue="http://loki:3100/loki/api/v1/push"/>
        <appender name="LOKI" class="com.github.loki4j.logback.Loki4jAppender">
            <http>
                <url>${LOKI_URL}</url>
            </http>
            <labels>
                app = transaction-service
                environment = production
                level = %level
            </labels>
            <message class="com.github.loki4j.logback.JsonLayout"/>
        </appender>
        <root level="INFO">
            <appender-ref ref="JSON"/>
            <appender-ref ref="LOKI"/>
        </root>
    </springProfile>

</configuration>
